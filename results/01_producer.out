CREATE TABLE dsdemo.users AS
SELECT ((a.i - 1) * 200 + b.i)::int AS userid,
       'user' || ((a.i - 1) * 200 + b.i) AS username,
       decode((random() * 7)::int, 0,'CA', 1,'NY', 2,'TX', 3,'WA', 4,'FL', 5,'IL', 6,'CO', 'MA') AS state
FROM n a, n b WHERE a.i <= 1000 AND b.i <= 200;
